# ---- LLM provider: fake | anthropic | openai ----
# "fake" needs no API key and is what the tests use.
COMPLIBOT_LLM_PROVIDER=fake

# Anthropic (Claude). Model names come from env so you can swap without code changes.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking depth / spend: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (re-runs a declined request on a fallback model). "default" or "off".
ANTHROPIC_FALLBACKS=default

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- Evaluation (LLM-as-judge) ----
# Use a different model from the one under test to limit self-preference bias.
COMPLIBOT_JUDGE_PROVIDER=fake
COMPLIBOT_JUDGE_MODEL=claude-sonnet-5-5

# ---- Retrieval ----
# Dense embeddings: none | openai | hash   (none = BM25 only, fully offline)
COMPLIBOT_EMBEDDER=none
COMPLIBOT_TOP_K=6
# Query rewriting: none | rules (offline glossary) | llm
COMPLIBOT_REWRITER=none
# Reranker: none | lexical (offline) | cross-encoder (pip install sentence-transformers) | llm
COMPLIBOT_RERANKER=none
COMPLIBOT_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Chunking strategy used by `complibot ingest`: section | fixed
COMPLIBOT_CHUNKING=section

# ---- Guardrails & reliability ----
# PII redaction before anything reaches the LLM/logs/traces: auto | presidio | regex | off
COMPLIBOT_PII_ENGINE=auto
COMPLIBOT_PII_PERSON=false
COMPLIBOT_SPACY_MODEL=en_core_web_sm
COMPLIBOT_BLOCK_INJECTION=true
COMPLIBOT_LLM_TIMEOUT=60
COMPLIBOT_LLM_MAX_RETRIES=3
COMPLIBOT_AGENT_MAX_STEPS=6
# JSONL audit log (role, status, documents touched, PII counts; never raw text). Empty = off.
COMPLIBOT_AUDIT_LOG=

# ---- Observability (Langfuse). Tracing is on only when both keys are set. ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Paths ----
COMPLIBOT_DATA_DIR=data/raw
COMPLIBOT_INDEX_DIR=data/index

# ---- API access control ----
# Comma-separated API keys that map to the "internal" role. Anything else is "public".
COMPLIBOT_INTERNAL_API_KEYS=change-me-internal-key
