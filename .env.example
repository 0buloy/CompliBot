# ---- LLM provider: fake | anthropic | openai ----
# "fake" needs no API key and is what the tests use.
COMPLIBOT_LLM_PROVIDER=fake

# Anthropic (Claude). Model names come from env so you can swap without code changes.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking depth / spend: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (re-runs a declined request on a fallback model). "default" or "off".
ANTHROPIC_FALLBACKS=default

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- Evaluation (LLM-as-judge) ----
# Use a different model from the one under test to limit self-preference bias.
COMPLIBOT_JUDGE_PROVIDER=fake
COMPLIBOT_JUDGE_MODEL=claude-sonnet-5-5

# ---- Retrieval ----
# Dense embeddings: none | openai | hash   (none = BM25 only, fully offline)
COMPLIBOT_EMBEDDER=none
COMPLIBOT_TOP_K=6
# Chunking strategy used by `complibot ingest`: section | fixed
COMPLIBOT_CHUNKING=section

# ---- Paths ----
COMPLIBOT_DATA_DIR=data/raw
COMPLIBOT_INDEX_DIR=data/index

# ---- API access control ----
# Comma-separated API keys that map to the "internal" role. Anything else is "public".
COMPLIBOT_INTERNAL_API_KEYS=change-me-internal-key
